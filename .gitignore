# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Claude Code / ruflo tooling (local only — not part of the website)
.claude/
.claude-flow/
.mcp.json

# Package manager stray — project pakai npm (package-lock.json), bukan pnpm
pnpm-lock.yaml

# Data dump / artefak scratch dari scripts/ debug tools (bukan source code,
# bisa besar dan/atau berisi data produksi) — regenerasi via script terkait bila perlu
scripts/screenshots/
scripts/deskripsi_backup.json
scripts/_maps_check.json

# Ekspor D1. CLAUDE.md MEWAJIBKAN `wrangler d1 export --remote` sebelum setiap
# operasi tulis ke produksi, jadi berkas ini akan terus bermunculan (±22 MB).
# Isinya seluruh database produksi: leads (nama + nomor telepon) dan agreements
# (nik_encrypted). JANGAN sampai ikut ter-commit oleh `git add -A`.
*.sql
!migrations/*.sql
backup-*.sql

# Artefak dari redireksi shell yang salah kutip saat sesi debug (nama berkas
# seperti "0)" atau "p.col"). Bukan source code — jangan pernah ikut ter-commit.
[0-9])
0
p.col
rows.length
bullet
