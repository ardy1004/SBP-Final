# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-ssr/
.output/

# Environment & secrets
.env
.env.*
!.env.example
.dev.vars

# File uji curl (curl -c / curl -b / body sementara)
cookies.txt
login.json
login-bad.json
lead.json
lead-bad.json
*-test.json
*-bad.json

# Artefak pengukuran bundle (scripts/check-bundle-budget.mjs)
.bundle-check/
.bundle-baseline/

# Cloudflare local development
.wrangler/
wrangler.toml.local

# React Router generated files
.react-router/

# Editor / OS artifacts
.DS_Store
Thumbs.db
*.local
.vscode/settings.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Claude Code / ruflo tooling (local only — not part of the website)
.claude/
.claude-flow/
.mcp.json

# Package manager stray — project pakai npm (package-lock.json), bukan pnpm
pnpm-lock.yaml

# Data dump / artefak scratch dari scripts/ debug tools (bukan source code,
# bisa besar dan/atau berisi data produksi) — regenerasi via script terkait bila perlu
scripts/screenshots/
scripts/deskripsi_backup.json
scripts/_maps_check.json

# Ekspor D1. CLAUDE.md MEWAJIBKAN `wrangler d1 export --remote` sebelum setiap
# operasi tulis ke produksi, jadi berkas ini akan terus bermunculan (±22 MB).
# Isinya seluruh database produksi: leads (nama + nomor telepon) dan agreements
# (nik_encrypted). JANGAN sampai ikut ter-commit oleh `git add -A`.
*.sql
!migrations/*.sql
backup-*.sql

# CATATAN — JANGAN tambahkan pola penyembunyi "artefak shell" di sini.
# .gitignore ikut dibaca pemindai @source Tailwind v4 (src/styles/tailwind.css).
# Pada 2026-07-27 pola bermetakarakter brace tak berpasangan (`*{`, `*}`) di berkas
# ini membuat scanner tidak menemukan satu pun kelas: CSS produksi runtuh dari
# 128 KB menjadi 13 KB — situs tampil tanpa gaya — sementara `npm run build`,
# `check:bundle`, dan `smoke` SEMUANYA hijau. Terbukti lewat bisect: brace merusak,
# kurung biasa `*(`/`*)` tidak. Artefak shell cukup dihapus manual; menyembunyikannya
# tidak sepadan dengan risiko mengosongkan seluruh CSS.
# Penjaga: scripts/check-bundle-budget.mjs memeriksa lantai ukuran CSS.
