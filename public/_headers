# Cloudflare Pages headers

# Security headers untuk semua route (defense-in-depth).
# Catatan: CSP sengaja TIDAK diset di sini karena root.tsx menyuntikkan inline
# script pixel/gtag/gtm — CSP ketat butuh nonce per-request (belum diimplementasi).
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin

# Font self-hosted — immutable (nama file berubah jika font di-update)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Asset hasil build Vite ber-hash — immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
